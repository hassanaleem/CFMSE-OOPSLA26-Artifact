array buf[32] : w32 -> w8 = symbolic
array model_version[4] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 model_version))
         (Eq 32
             (Extract w8 0 (And w32 N0:(ZExt w32 (Read w8 0 buf))
                                    224)))
         (Eq 16 (And w32 N0 31))
         (Eq 0
             (And w32 (ZExt w32 N1:(Read w8 1 buf))
                      128))
         (Eq false
             (Slt 0
                  (Extract w32 0 (ZExt w64 N1))))]
        false)
