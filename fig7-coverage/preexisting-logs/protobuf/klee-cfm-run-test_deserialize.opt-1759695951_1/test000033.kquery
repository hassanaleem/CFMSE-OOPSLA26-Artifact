array buf[10] : w32 -> w8 = symbolic
(query [(Eq false
             (Ult N0:(Read w8 0 buf) 8))
         (Slt 255 N0)
         (Eq false
             (Eq 1
                 N1:(And w8 (LShr w8 N0 3) 15)))
         (Eq false
             (Slt (ZExt w32 N1) 3))
         (Eq 5 (And w8 N0 7))
         (Eq false
             (Ult N2:(Read w8 5 buf) 8))
         (Slt 255 N2)
         (Eq 1
             (And w8 (LShr w8 N2 3) 15))
         (Eq 0 (And w8 N2 7))
         (Eq false
             (Slt 255 (Read w8 6 buf)))
         (Eq false
             (Slt 255 (Read w8 7 buf)))
         (Eq false
             (Slt 255 (Read w8 8 buf)))
         (Slt 255 (Read w8 9 buf))]
        false)
